# Copy to .env for local development. Validated by app/core/config.py (T-002).
ENV=local

DATABASE_URL=postgresql+asyncpg://oursport:oursport@localhost:5432/oursport
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY_ID=oursport-local
S3_SECRET_ACCESS_KEY=oursport-local-secret
S3_BUCKET=oursport-local
S3_REGION=eu-north-1

PUBLIC_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
WIDGET_EMBED_ORIGINS=
JWT_SECRET=change-me-local-only
COOKIE_DOMAIN=localhost
MAGIC_LINK_PER_EMAIL_PER_HOUR=5
MAGIC_LINK_PER_IP_PER_HOUR=20

EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_FROM=OurSport <no-reply@oursport.local>

# Previous fake/Anthropic provider settings:
# LLM_PROVIDER=fake
# LLM_API_KEY=
# LLM_MODEL=claude-opus-5-5
# For the hosted DeepSeek API, set your key locally (do not commit it):
# LLM_PROVIDER=deepseek
# LLM_API_KEY=your-deepseek-api-key
# LLM_MODEL=deepseek-chat
LLM_PROVIDER=ollama
LLM_OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.5:9b
LLM_DAILY_TOKEN_BUDGET=2000000
LLM_TOURNAMENT_TOKEN_BUDGET=300000
POLICY_CATALOGUE_VERSION=1

UPLOAD_MAX_MB=10
MALWARE_SCAN_URL=

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
FEATURE_FLAGS=
