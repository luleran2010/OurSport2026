{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "mock_backend", "uvicorn", "app.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "real-backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "uvicorn", "app.main:app", "--port", "8002"],
      "env": { "PYTHONUTF8": "1" },
      "port": 8002
    },
    {
      "name": "frontend-real-backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5180"],
      "env": { "API_PROXY": "http://127.0.0.1:8002" },
      "port": 5180
    },
    {
      "name": "real-backend-alt",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "uvicorn", "app.main:app", "--port", "8012"],
      "env": { "PYTHONUTF8": "1" },
      "port": 8012,
      "autoPort": false
    },
    {
      "name": "frontend-real-backend-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5190"],
      "env": { "API_PROXY": "http://127.0.0.1:8012" },
      "port": 5190
    }
  ]
}
